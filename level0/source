#define _GNU_SOURCE
#include <unistd.h>

#include <stdlib.h>
#include <sys/types.h>
#include <stdio.h>
#include <string.h>

int main(int argc, char *argv[]) {
	int n = atoi(argv[1]);
	if (n == 423) {
		char *command[] = {strdup("/bin/sh"), NULL};
		gid_t gid = getegid();
		uid_t uid = geteuid();
		setresgid(gid, gid, gid);
		setresuid(uid, uid, uid);
		execv("/bin/sh", command);
	}
	else {
		fwrite("No !\n", 1, 5, stderr);
	}
}
